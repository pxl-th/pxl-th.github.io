---
import Layout from '../../layouts/Layout.astro';
import SplatViewer from '../../components/SplatViewer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Rendered through the classic per-splat path rather than the viewer's default
// unified work buffer, which quantises colour, rotation and scale and culls
// sub-2px splats before the rasterizer sees them. See the 'classic gsplat path'
// patches in scripts/copy-viewer.mjs.
---

<Layout title="Memorial">
    <header>
        <nav>
            <a href={`${base}/`}>main</a>
            <a href={`${base}/blog`}>blog</a>
        </nav>
    </header>
    <div class="split">
        <SplatViewer
            name="memorial-3"
            title="Memorial — Gaussian splat scene"
            format="sog"
            walkOnly
            collision
            classic
        />
        <div class="split-copy">
            <h2><span class="tryzub" aria-hidden="true">A</span></h2>
            <p>29 серпня ⋅ День пам'яті загиблих захисників України</p>
            <p>29th of august ⋅ Day of Remembrance for Fallen Defenders in Ukraine</p>

            <p class="product-meta">
            Made with <a href="better-gs-julia/" target="_blank" rel="noopener">GaussianSplatting.jl</a><br>
            </p>

            <p class="product-back">
                <a href={`${base}/blog`}>← back</a>
            </p>
        </div>
    </div>
</Layout>
