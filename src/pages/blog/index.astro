---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Blog">
    <header>
        <nav>
            <a href={`${base}/`}>main</a>
            <a href={`${base}/blog`}>blog</a>
        </nav>
    </header>
    <div class="content">
        <div class="side">
            <div class="c2">
                <ul class="posts">
                    <li>
                        <a href={`${base}/blog/concept-store-2`}>Concept Store #2</a>
                    </li>
                    <li>
                        <a href={`${base}/blog/concept-store`}>Concept Store</a>
                    </li>
                    <li>
                        <a href={`${base}/blog/better-gs-julia`}>Better Gaussian Splatting in Julia</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</Layout>
