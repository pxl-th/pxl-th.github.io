---
import Layout from '../../layouts/Layout.astro';
import SplatViewer from '../../components/SplatViewer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// public/splats/aqyar-cup.sog is gitignored like the other splats, so the
// command that produced it lives here - it is the only record of how the scan was cleaned up:
//
// npx @playcanvas/splat-transform@3.3.0 cup-default-strategy-60k-depth-0-sh-random-bg.ply -t 0.436,1.2,-2.4 -r 59,-75,2 public/splats/aqyar-cup.sog --overwrite
// npx @playcanvas/splat-transform@3.3.0 /home/pxlth/GaussianSplattingModels/aqyar-cup/cup-default-strategy-30k-depth-1-sh-random-bg-geometry-from-10k.ply -t 0.436,1.2,-2.4 -r 59,-75,2 public/splats/aqyar-cup.sog --overwrite
//
// -t recenters it on the origin so the camera can just look at 0,0,0.
// -r stands it upright.
---

<Layout title="Concept Store">
    <header>
        <nav>
            <a href={`${base}/`}>main</a>
            <a href={`${base}/blog`}>blog</a>
        </nav>
    </header>
    <div class="content">
        <div class="product">
            <SplatViewer
                name="aqyar-cup"
                title="Aqyar Cup — Gaussian splat scene"
                orbitOnly
                noPan
                fitFov
                noControls
                autoOrbit={10}
                autoOrbitDelay={1000}
                zoomRange={[2, 4]}
                pitchRange={[-70, -10]}
            />
            <div class="product-info">
                <h1>Coffee Mug</h1>
                <p class="product-meta">
                reconstructed with <a href={`${base}/blog/better-gs-julia`} target="_blank" rel="noopener">GaussianSplatting.jl</a><br>
                drag to rotate
                </p>

                <p>
                Coffee mug by <a href="https://aqyarceramics.com/" target="_blank" rel="noopener">Aqyar Ceramics</a>.
                </p>

                <p>
                here goes the description<br>
                .........................<br>
                .........................<br>
                .........................<br>
                .........................<br>
                .......end of description
                </p>

                <p>
                product info:
                </p>

                <p>
                ∪ volume: 250 ml<br>
                ⌀ diameter: 8 cm<br>
                [ height: 8 cm<br>
                ⊥ weight: 150 g
                </p>

                <p class="price">₴ the number</p>

                <button class="buy" type="button">buy</button>
                <p class="buy-note" hidden>
                this is a *concept*<br>
                go to the real <a href="https://aqyarceramics.com/" target="_blank" rel="noopener">store</a>
                </p>

                <p class="product-back">
                    <a href={`${base}/blog`}>← back</a>
                </p>
            </div>
        </div>
    </div>
</Layout>

<script>
    // The store is a mock-up; the button only owns up to that.
    const buy = document.querySelector<HTMLButtonElement>('.buy');
    const note = document.querySelector<HTMLParagraphElement>('.buy-note');

    buy?.addEventListener('click', () => {
        if (note) note.hidden = false;
        buy.disabled = true;
    });
</script>
